{
  "name": "habib-ai",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "update:local": "node scripts/update-local.mjs --start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "curriculum": "tsx scripts/review-curriculum.ts",
    "retention": "tsx scripts/retention.ts",
    "format": "prettier --write src scripts tests *.ts",
    "format:check": "prettier --check src scripts tests *.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.7",
    "next": "^16.0.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^23.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
