# Local development needs no credentials. Use fictional profiles until external reviews pass.
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production: Supabase Auth + PostgreSQL. Keys remain server-side unless explicitly public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Optional path to the provider's official CA certificate. TLS verification remains enabled.
HABIB_DATABASE_CA_PATH=
# Production registration is invitation-only. Choose your own secure code; never commit it.
HABIB_INVITE_CODE=

# Azure Speech resource: use your resource's actual region.
HABIB_SPEECH_KEY=
HABIB_SPEECH_REGION=westeurope

# Server-side OpenAI credential; the alternative name supports cloud secret bindings.
HABIB_OPENAI_KEY=
HABIB_TUTOR_MODEL=gpt-4.1-mini
HABIB_HOMEWORK_MODEL=gpt-4.1-mini
HABIB_AI_ENABLED=true

# Stripe: use sandbox keys first. Configure and test signed webhooks before live payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FAMILY_PRICE_ID=
HABIB_FAMILY_PRICE_EUR=7.99
HABIB_MONTHLY_VOICE_MINUTES=120

HABIB_SPEECH_ENABLED=true
HABIB_HOMEWORK_ENABLED=true
